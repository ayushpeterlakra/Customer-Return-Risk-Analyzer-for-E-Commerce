# Copy to .env and adjust. Never commit .env.
APP_NAME="Customer Return Risk Analyzer API"
APP_ENV=development
# PostgreSQL connection (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+psycopg://rra_user:rra_password@localhost:5432/return_risk
# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
# Optional: fix the scoring reference date (YYYY-MM-DD). Leave empty to use today.
SCORING_AS_OF=
# Folder holding model.joblib and metrics.json (relative to backend/)
MODEL_DIR=ml_artifacts
# Optional email alerts for newly high-risk customers (leave SMTP_HOST empty to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
